# Copy to .env. Local development needs no configuration.
HOST=127.0.0.1
PORT=4173
# Restrict public test registration to one-use invitation codes.
# REGISTRATION_MODE=invite
# Production: HTTPS reverse proxy to the Node server; same origin for pages and API.
# NODE_ENV=production
# APP_ORIGIN=https://assessment.example.com
# TRUST_PROXY=loopback
# Keep these directories on a persistent disk. Defaults are ./data/auth and ./data/traces.
# AUTH_DATA_DIR=/var/lib/yuzhi/auth
# TRACE_DATA_DIR=/var/lib/yuzhi/traces
# AI assistant: DeepSeek V4 Flash via Alibaba Cloud Model Studio. Never put keys in public/.
# AI_API_KEY=your-dashscope-api-key
# AI_MODEL=deepseek-v4-flash-0731
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_DATA_DIR=/var/lib/yuzhi/agent
# Each account has an independent cumulative cap across projects, including summaries (RMB).
# AI_USER_BUDGET_RMB=30
# Working-context compression threshold in UTF-8 bytes, NOT a token count.
# AI_CONTEXT_BYTES=70000

# Isolated run records, immutable source snapshots and output artifacts.
# RUN_DATA_DIR=/var/lib/yuzhi/runs
# 教师过程评价的持久化目录（默认 data/assessments；与轨迹一起备份）
# ASSESSMENT_DATA_DIR=/path/to/persistent/assessments

# Long-term student observations and teacher review history
# MEMORY_DATA_DIR=/persistent/yuzhi/memory

# Experimental agent-initiated read-only memory search; disabled by default.
AI_MEMORY_SEARCH_ENABLED=false
